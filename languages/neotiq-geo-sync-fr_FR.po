#. Plugin Name of the plugin
msgid "Neotiq Geo Sync"
msgstr "Neotiq Géo-sync"

#. Plugin URI and Author URI of the plugin
msgid "https://neotiq.com/"
msgstr ""

#. Description of the plugin
msgid "Derives the Country, Region, Department, Arrondissement and City taxonomies from the ACF OpenStreetMap address of venues and providers. Runs on save in both the admin and the JetFormBuilder front-end forms, and ships a bulk correction tool."
msgstr "Déduit les taxonomies Pays / Région / Département / Arrondissement / Ville depuis l'adresse ACF OpenStreetMap des établissements et prestataires. S'exécute à l'enregistrement, dans l'administration comme dans les formulaires JetFormBuilder du site, et fournit un outil de correction en masse."

#. Author of the plugin
msgid "Neotiq"
msgstr ""

#: admin/ajax.php:19 admin/tools-page.php:150
msgid "You are not allowed to access this page."
msgstr "Vous n'avez pas l'autorisation d'accéder à cette page."

#: admin/tools-page.php:29 admin/tools-page.php:30 admin/tools-page.php:154
msgid "Neotiq Geo Sync"
msgstr "Neotiq Géo-sync"

#: admin/tools-page.php:69
msgid "Checking…"
msgstr "Vérification en cours…"

#: admin/tools-page.php:70
msgid "Checked %1$d of %2$d"
msgstr "%1$d fiches vérifiées sur %2$d"

#: admin/tools-page.php:71
msgid "Check finished: %d post(s) processed."
msgstr "Vérification terminée : %d fiche(s) traitée(s)."

#: admin/tools-page.php:72
msgid "Nothing to check: every post is up to date. Use \"Re-check everything\" to force a full pass."
msgstr "Rien à vérifier : toutes les fiches sont à jour. Utilisez « Tout revérifier » pour forcer une passe complète."

#: admin/tools-page.php:73
msgid "Applying…"
msgstr "Application en cours…"

#: admin/tools-page.php:74
msgid "Applied to %d post(s)."
msgstr "Appliqué à %d fiche(s)."

#: admin/tools-page.php:75
msgid "%d selected"
msgstr "%d sélectionnée(s)"

#: admin/tools-page.php:76
msgid "Select at least one post first."
msgstr "Sélectionnez au moins une fiche."

#: admin/tools-page.php:77
msgid "Apply the corrections to %d post(s)?\n\nBack up your database first: this overwrites the existing terms and cannot be undone from this screen."
msgstr "Appliquer les corrections à %d fiche(s) ?\n\nSauvegardez d'abord votre base de données : les termes existants seront écrasés et cette opération est irréversible depuis cet écran."

#: admin/tools-page.php:78
msgid "Delete every stored result? The posts themselves are not touched, but the next check will have to walk through all of them again."
msgstr "Supprimer tous les résultats enregistrés ? Les fiches elles-mêmes ne sont pas touchées, mais la prochaine vérification devra toutes les reparcourir."

#: admin/tools-page.php:79
msgid "%d stored result(s) deleted."
msgstr "%d résultat(s) enregistré(s) supprimé(s)."

#: admin/tools-page.php:80
msgid "The request failed. Check the browser console, then start the batch again."
msgstr "La requête a échoué. Consultez la console du navigateur, puis relancez le lot."

#: admin/tools-page.php:81
msgid "Stopped. Start it again to carry on where it left off."
msgstr "Arrêté. Redémarrez pour reprendre où la vérification s'est interrompue."

#: admin/tools-page.php:82
msgid "Loading…"
msgstr "Chargement…"

#: admin/tools-page.php:83
msgid "No stored result matches this filter."
msgstr "Aucun résultat enregistré ne correspond à ce filtre."

#: admin/tools-page.php:84
msgid "Showing %1$d–%2$d of %3$d"
msgstr "%1$d–%2$d sur %3$d"

#: admin/tools-page.php:85
msgid "Last check: %s"
msgstr "Dernière vérification : %s"

#: admin/tools-page.php:86
msgid "No check stored yet."
msgstr "Aucune vérification enregistrée pour le moment."

#: admin/tools-page.php:87
msgid "Apply to all %d matching posts"
msgstr "Appliquer aux %d fiches correspondantes"

#: admin/tools-page.php:155
msgid "Reads the OpenStreetMap address of every post and corrects its country, region, department, arrondissement and city terms. Findings are stored, so you can review them later without checking everything again."
msgstr "Relit l'adresse OpenStreetMap de chaque fiche et corrige ses termes pays, région, département, arrondissement et ville. Les résultats sont enregistrés : vous pouvez les examiner plus tard sans tout revérifier."

