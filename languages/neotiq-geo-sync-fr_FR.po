msgid_plural "City “%1$s %2$s” could not be resolved (%3$d terms on this postcode), city left unchanged."
msgstr[0] "Ville « %1$s %2$s » non résolue (%3$d terme sur ce code postal), ville inchangée."
msgstr[1] "Ville « %1$s %2$s » non résolue (%3$d termes sur ce code postal), ville inchangée."

#. translators: %s: newly created term name.
#: includes/sync.php:282
