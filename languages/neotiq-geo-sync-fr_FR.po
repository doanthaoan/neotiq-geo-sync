#. translators: %s: ISO country code returned by the geocoder.
#: includes/sync.php:76
msgid "Country “%s” is missing from the eu taxonomy."
msgstr "Pays « %s » absent de la taxonomie eu."

#. translators: 1: country term(s) on the post, 2: ISO country code from the address.
#: includes/sync.php:85
msgid "Country mismatch: post says “%1$s”, address says “%2$s”. Nothing was changed, this needs a manual decision."
msgstr "Pays incohérent : la fiche indique « %1$s », l'adresse « %2$s ». Aucune correction appliquée, à trancher manuellement."

#. translators: 1: department code, 2: department name.
#: includes/sync.php:140
msgid "Department not found in the localisation taxonomy (code “%1$s”, name “%2$s”)."
msgstr "Département introuvable dans la taxonomie localisation (code « %1$s », nom « %2$s »)."

#: includes/sync.php:151
msgid "Address outside the Base Adresse Nationale, fell back to Photon (no arrondissement detection)."
msgstr "Adresse hors Base Adresse Nationale, repli sur Photon (pas de détection d'arrondissement)."

#. translators: 1: arrondissement number, 2: city name.
